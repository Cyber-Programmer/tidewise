# Dummy package for the Tidewise container tests (WBS 6.1). Contains one text file and nothing else.
pkgname=tidewise-dummy-vprov-2
pkgver=1.0
pkgrel=1
pkgdesc="Tidewise test provider of tidewise-vvirtual=2"
arch=('any')
url="https://github.com/Cyber-Programmer/tidewise"
license=('GPL-3.0-or-later')
options=('!debug' '!strip')
provides=('tidewise-vvirtual=2')
package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
  echo "$pkgname $pkgver" > "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
}
