# Reports what an install scriptlet sees: its environment, its umask, its resource limits, its out-of-memory score, and a command found through PATH.
post_install() {
  uname -s > /tmp/tidewise-scriptlet-uname
  command -v uname > /tmp/tidewise-scriptlet-uname-path
  env | sort > /tmp/tidewise-scriptlet-env
  umask > /tmp/tidewise-scriptlet-umask
  cat /proc/self/limits > /tmp/tidewise-scriptlet-limits
  cat /proc/self/oom_score_adj > /tmp/tidewise-scriptlet-oom
}
