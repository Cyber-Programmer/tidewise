# Dummy package for the Tidewise container tests (WBS 6.5, review T-01). Contains one text file and nothing else.
pkgname=tidewise-dummy-self
pkgver=1.0
pkgrel=1
pkgdesc="Tidewise test package that replaces its own name and provides another name"
arch=('any')
url="https://github.com/Cyber-Programmer/tidewise"
license=('GPL-3.0-or-later')
options=('!debug' '!strip')
replaces=('tidewise-dummy-self')
provides=('tidewise-dummy-selfneed')
package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
  echo "$pkgname $pkgver" > "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
}
