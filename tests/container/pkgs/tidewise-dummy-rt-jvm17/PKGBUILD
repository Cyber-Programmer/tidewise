# Dummy package for the Tidewise container tests (WBS 6.6, review V-01). Contains one text file and nothing else.
pkgname=tidewise-dummy-rt-jvm17
pkgver=1.0
pkgrel=1
pkgdesc="Tidewise test provider of tidewise-jvm 17, pacman's default"
arch=('any')
url="https://github.com/Cyber-Programmer/tidewise"
license=('GPL-3.0-or-later')
options=('!debug' '!strip')
provides=('tidewise-jvm=17')
package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
  echo "$pkgname $pkgver" > "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
}
