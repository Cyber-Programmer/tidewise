# Dummy package for the Tidewise container tests (WBS 6.4b). Contains one text file and nothing else.
pkgname=tidewise-dummy-needs-jv-9
pkgver=1.0
pkgrel=1
pkgdesc="Tidewise test package that needs tidewise-jv=9"
arch=('any')
url="https://github.com/Cyber-Programmer/tidewise"
license=('GPL-3.0-or-later')
options=('!debug' '!strip')
depends=('tidewise-jv=9')
package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
  echo "$pkgname $pkgver" > "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
}
