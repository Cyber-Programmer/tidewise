# Makes the next `pacman -Q` fail ("database is incorrect version", exit 255), so the helper's second list cannot be read.
# The test puts the file back from the copy in /tmp.
post_install() {
  cp /var/lib/pacman/local/ALPM_DB_VERSION /tmp/tidewise-db-version-backup
  rm /var/lib/pacman/local/ALPM_DB_VERSION
}
