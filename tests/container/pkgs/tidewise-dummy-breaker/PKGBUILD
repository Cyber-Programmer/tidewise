# Dummy package for the Tidewise container tests (WBS 5.3c). Contains one text file and nothing else.
pkgname=tidewise-dummy-breaker
pkgver=1.0
pkgrel=1
pkgdesc="Tidewise test package whose install script makes `pacman -Q` fail"
arch=('any')
url="https://github.com/Cyber-Programmer/tidewise"
license=('GPL-3.0-or-later')
options=('!debug' '!strip')
install=tidewise-dummy-breaker.install
package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
  echo "$pkgname $pkgver" > "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
}
