# Dummy package for the Tidewise container tests (WBS 5.3b). Contains one text file and nothing else.
pkgname=tidewise-dummy-old
pkgver=2.0
pkgrel=1
pkgdesc="Tidewise test package, the newer version of the replaced one, which needs another package"
arch=('any')
url="https://github.com/Cyber-Programmer/tidewise"
license=('GPL-3.0-or-later')
options=('!debug' '!strip')
depends=('tidewise-dummy-hello')
package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
  echo "$pkgname $pkgver" > "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
}
