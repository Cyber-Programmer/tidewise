# Dummy package for the Tidewise container tests (WBS 6.6, review U-01). Contains one text file and nothing else.
pkgname=tidewise-dummy-rt-user
pkgver=2.0
pkgrel=1
pkgdesc="Tidewise test package rebuilt for the new soname"
arch=('any')
url="https://github.com/Cyber-Programmer/tidewise"
license=('GPL-3.0-or-later')
options=('!debug' '!strip')
depends=('libtidewiserun.so=2-64')
package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
  echo "$pkgname $pkgver" > "$pkgdir/usr/share/tidewise-test/$pkgname.txt"
}
