import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TwButton } from "../widgets/button.slint";
import { RadioList, CheckRow } from "../widgets/choice-list.slint";
import { InstallBridge, InstallCardKind, InstallFocus } from "bridge.slint";
import { ReviewList, ReviewTile } from "review-list.slint";
import { InstallProgress } from "progress-card.slint";

// Select all / Select none.
component SelectButtons inherits HorizontalLayout {
    spacing: Theme.space-s;
    alignment: end;
    TwButton {
        text: "Select all";
        clicked => {
            InstallBridge.select-all();
        }
    }

    TwButton {
        text: "Select none";
        clicked => {
            InstallBridge.select-none();
        }
    }
}

// "62 of 62 selected · 3 already installed" with Select all / Select none. Side by side while the summary fits on
// one line next to the buttons; otherwise the buttons go below it. No fixed threshold: it compares the row's width
// with the summary's one-line width plus the buttons' preferred width. The two are placed by hand (one instance of
// each, so there is one Tab stop per button) and the row reports its own height, so the card's layout never depends
// on which arrangement is shown.
component SummaryRow inherits Rectangle {
    in property <string> summary;
    in property <bool> show-buttons;

    property <length> buttons-width: root.show-buttons ? buttons.preferred-width : 0px;
    property <bool> stacked: root.show-buttons && root.width < label.preferred-width + root.buttons-width + Theme.space-m;
    property <length> label-height: label.preferred-height;

    min-height: root.stacked ? root.label-height + Theme.space-s + buttons.preferred-height : max(root.label-height, buttons.preferred-height);
    preferred-height: self.min-height;
    max-height: self.min-height;

    label := Text {
        x: 0px;
        y: root.stacked || !root.show-buttons ? 0px : (root.height - self.height) / 2;
        width: root.stacked ? root.width : max(0px, root.width - root.buttons-width - Theme.space-m);
        text: root.summary;
        color: Theme.text-2;
        font-size: Theme.size-label;
        wrap: word-wrap;
        accessible-role: text;
    }

    buttons := SelectButtons {
        visible: root.show-buttons;
        x: root.stacked ? 0px : root.width - self.preferred-width;
        y: root.stacked ? root.label-height + Theme.space-s : (root.height - self.preferred-height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        alignment: start;
    }
}

// The one card of the install screen. What it shows depends on `InstallBridge.kind`; every word and flag comes
// from Rust. Focus: the element named by `InstallBridge.focus` takes it when the card appears and whenever
// `focus-serial` changes (a new question, a new result).
//
// Layout rules (docs/design/tokens.md, "Layout rules"): the card's height comes from the layout, not from a
// subtraction. Long lists sit in their own bounded boxes, direct children of the card's layout: they start at
// their smallest size (3 rows, or 96px for the already-installed list) and share the spare height 65 / 35, but
// never grow past their content, so short lists stay short. The buttons are the last child and keep their size.
export component InstallCard inherits Rectangle {
    property <length> check-pitch: Theme.choice-check-row + 1px;
    property <length> radio-pitch: Theme.choice-radio-row + 1px;
    // The height of each list when it shows every row (rows, separators between them, 1px border).
    property <length> members-full: InstallBridge.kind == InstallCardKind.members && InstallBridge.options.length > 0 ? InstallBridge.options.length * root.check-pitch + 1px : 0px;
    property <length> installed-full: InstallBridge.kind == InstallCardKind.members && InstallBridge.installed-rows.length > 0 ? InstallBridge.installed-rows.length * 30px + 2 * Theme.space-m - Theme.space-s + 2px : 0px;
    property <length> radio-full: InstallBridge.kind == InstallCardKind.provider || InstallBridge.kind == InstallCardKind.choice ? InstallBridge.options.length * root.radio-pitch + 1px : 0px;
    property <length> members-min: min(root.members-full, 3 * root.check-pitch);
    property <length> installed-min: min(root.installed-full, 96px);
    property <length> radio-min: min(root.radio-full, 3 * root.radio-pitch);

    property <bool> review: InstallBridge.kind == InstallCardKind.review;
    property <length> review-full: root.review ? InstallBridge.review-rows.length * (Theme.review-row + 1px) + 1px : 0px;
    property <length> review-min: min(root.review-full, 3 * (Theme.review-row + 1px));

    // The layout starts every list at its smallest size, so the card's own preferred height is the smallest one;
    // its most is that plus what the lists need to show every row (short cards stay short).
    max-height: content.preferred-height + (root.members-full - root.members-min) + (root.installed-full - root.installed-min) + (root.radio-full - root.radio-min) + (root.review-full - root.review-min);

    // The review always takes the full width up to the maximum: otherwise opening its technical details, whose
    // lines are longer, would make the card jump wider.
    preferred-width: root.review ? Theme.content-max-width : content.preferred-width;

    background: Theme.surface;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: InstallBridge.kind == InstallCardKind.review ? Theme.control-border : Theme.border;

    // View state only: is the "Technical details" part open?
    property <bool> technical-open: false;

    content := VerticalLayout {
        // The review holds the most, so it is a little tighter: it has to fit the smallest window.
        padding-left: root.review ? Theme.space-xl : 28px;
        padding-right: root.review ? Theme.space-xl : 28px;
        padding-top: root.review ? Theme.space-l : 28px;
        padding-bottom: root.review ? Theme.space-l : 28px;
        spacing: root.review ? Theme.space-m : Theme.space-l;

        // "Question 2 of 3" and one bar per question.
        if InstallBridge.step-text != "": HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-s;
            Text {
                text: InstallBridge.step-text;
                color: Theme.text-2;
                font-size: Theme.size-label;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }

            Rectangle { }

            for dot in InstallBridge.dots: Rectangle {
                width: 28px;
                height: 6px;
                border-radius: 3px;
                y: (parent.height - self.height) / 2;
                background: dot == 0 ? Theme.accent : dot == 1 ? Theme.text-2 : Theme.control-border;
            }
        }

        // Title: an amber mark for the cards that stop the install, then the words.
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-m;
            alignment: start;

            if InstallBridge.kind == InstallCardKind.alert || InstallBridge.kind == InstallCardKind.stale || InstallBridge.kind == InstallCardKind.differs || (InstallBridge.kind == InstallCardKind.done && InstallBridge.attention): VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.warning-bg;
                    Text {
                        text: "!";
                        color: Theme.warning;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if InstallBridge.kind == InstallCardKind.done && !InstallBridge.attention: VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.accent;
                    // Drawn, not typed: the app's fonts have no good check mark.
                    Path {
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M5 12l5 5 9-10";
                        stroke: Theme.on-accent;
                        stroke-width: 2.4px;
                        stroke-line-cap: round;
                        fill: transparent;
                    }
                }
            }

            Text {
                text: InstallBridge.title-before;
                color: Theme.text;
                font-size: Theme.size-dialog-title;
                font-weight: Theme.weight-semibold;
                wrap: InstallBridge.title-mono == "" ? word-wrap : no-wrap;
                horizontal-stretch: InstallBridge.title-mono == "" ? 1 : 0;
                vertical-alignment: center;
            }

            if InstallBridge.title-mono != "": Text {
                text: InstallBridge.title-mono;
                color: Theme.text;
                font-family: Theme.font-mono;
                font-size: Theme.size-row-title;
                font-weight: Theme.weight-medium;
                vertical-alignment: center;
                overflow: elide;
            }

            if InstallBridge.title-after != "": Text {
                text: InstallBridge.title-after;
                color: Theme.text;
                font-size: Theme.size-dialog-title;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }

            if InstallBridge.percent-text != "": Text {
                text: InstallBridge.percent-text;
                color: Theme.text-2;
                font-family: Theme.font-mono;
                font-size: Theme.size-body;
                vertical-alignment: center;
            }
        }

        if InstallBridge.body != "": Text {
            vertical-stretch: 0;
            text: InstallBridge.body;
            color: Theme.text-2;
            font-size: Theme.size-body;
            wrap: word-wrap;
        }

        if InstallBridge.kind == InstallCardKind.progress: InstallProgress {
            vertical-stretch: 0;
        }

        // The review: three figures, then the list.
        if root.review: HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-m;
            for tile in InstallBridge.tiles: ReviewTile {
                tile: tile;
            }
        }

        if root.review: ReviewList {
            vertical-stretch: 1;
            min-height: root.review-min;
            preferred-height: root.review-min;
            max-height: root.review-full;
            technical: root.technical-open;
        }

        // Provider or installed-package question.
        if InstallBridge.kind == InstallCardKind.provider || InstallBridge.kind == InstallCardKind.choice: RadioList {
            vertical-stretch: 1;
            min-height: root.radio-min;
            preferred-height: root.radio-min;
            max-height: root.radio-full;
            scroll-y <=> InstallBridge.list-y;
            visible-height <=> InstallBridge.list-visible-height;
            resized => {
                InstallBridge.list-resized();
            }
            options: InstallBridge.options;
            selected: InstallBridge.selected-index;
            label: InstallBridge.group-label;
            autofocus: InstallBridge.focus == InstallFocus.list;
            focus-request: InstallBridge.focus-serial;
            chosen(index) => {
                InstallBridge.choose(index);
            }
        }

        // Group members: the summary and Select all / none stay above the box.
        if InstallBridge.kind == InstallCardKind.members && InstallBridge.selection-text != "": SummaryRow {
            vertical-stretch: 0;
            summary: InstallBridge.selection-text;
            show-buttons: InstallBridge.show-select-buttons;
        }

        // The members to install: the larger share of the spare height (65).
        if InstallBridge.kind == InstallCardKind.members && InstallBridge.options.length > 0: Rectangle {
            vertical-stretch: 65;
            min-height: root.members-min;
            preferred-height: root.members-min;
            max-height: root.members-full;
            background: Theme.surface;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            accessible-role: groupbox;
            accessible-label: InstallBridge.group-label;
            ScrollView {
                content-y <=> InstallBridge.list-y;
                changed visible-height => {
                    InstallBridge.list-visible-height = self.visible-height;
                    InstallBridge.list-resized();
                }

                VerticalLayout {
                    for option[index] in InstallBridge.options: VerticalLayout {
                        if index > 0: Rectangle {
                            height: 1px;
                            background: Theme.rule;
                        }

                        CheckRow {
                            option: option;
                            row-index: index;
                            focus-row: InstallBridge.focus-row;
                            focus-row-request: InstallBridge.focus-row-request;
                            autofocus: index == 0 && InstallBridge.focus == InstallFocus.list;
                            focus-request: InstallBridge.focus-serial;
                            toggled => {
                                InstallBridge.toggle(index);
                            }
                            focused => {
                                InstallBridge.row-focused(index);
                            }
                            moved(delta) => {
                                InstallBridge.row-moved(index, delta);
                            }
                        }
                    }
                }
            }
        }

        // The members you already have: a second, smaller box (35).
        if InstallBridge.kind == InstallCardKind.members && InstallBridge.installed-rows.length > 0: Text {
            vertical-stretch: 0;
            text: InstallBridge.installed-heading;
            color: Theme.text-2;
            font-size: Theme.size-label;
            font-weight: Theme.weight-semibold;
        }

        if InstallBridge.kind == InstallCardKind.members && InstallBridge.installed-rows.length > 0: Rectangle {
            vertical-stretch: 35;
            min-height: root.installed-min;
            preferred-height: root.installed-min;
            max-height: root.installed-full;
            background: Theme.bg;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            ScrollView {
                VerticalLayout {
                    padding: Theme.space-m;
                    spacing: Theme.space-s;
                    for row in InstallBridge.installed-rows: HorizontalLayout {
                        height: 22px;
                        spacing: Theme.space-m;
                        Text {
                            text: row.name;
                            color: Theme.text-2;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-label;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Text {
                            text: row.version;
                            color: Theme.text-3;
                            font-family: Theme.font-mono;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "installed";
                            color: Theme.text-2;
                            font-size: 12px;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // A monospaced block that explains the card (versions, what was needed).
        if InstallBridge.code-lines.length > 0: Rectangle {
            vertical-stretch: 0;
            background: Theme.bg;
            border-radius: Theme.radius-chip;
            VerticalLayout {
                padding: Theme.space-m;
                for line in InstallBridge.code-lines: Text {
                    text: line;
                    color: Theme.text-2;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-label;
                    wrap: word-wrap;
                }
            }
        }

        if InstallBridge.unchanged != "": Text {
            vertical-stretch: 0;
            text: InstallBridge.unchanged;
            color: Theme.text-2;
            font-size: Theme.size-label;
            font-weight: Theme.weight-medium;
            wrap: word-wrap;
        }

        if InstallBridge.slow-note != "": Text {
            vertical-stretch: 0;
            text: InstallBridge.slow-note;
            color: Theme.text-2;
            font-size: Theme.size-body;
            wrap: word-wrap;
        }

        if InstallBridge.lists-note != "": Text {
            vertical-stretch: 0;
            text: InstallBridge.lists-note;
            color: Theme.text-2;
            font-size: Theme.size-label;
            wrap: word-wrap;
        }

        // On the review the hint sits beside the buttons.
        if InstallBridge.hint != "" && !root.review: Text {
            vertical-stretch: 0;
            text: InstallBridge.hint;
            color: Theme.text-2;
            font-size: Theme.size-body;
            wrap: word-wrap;
        }

        // On the review the toggle is under the buttons and swaps what the list box shows.
        if InstallBridge.technical.length > 0 && !root.review: HorizontalLayout {
            vertical-stretch: 0;
            TwButton {
                text: root.technical-open ? "Hide technical details" : "Technical details";
                clicked => {
                    root.technical-open = !root.technical-open;
                }
            }

            Rectangle { }
        }

        if root.technical-open && InstallBridge.technical.length > 0 && !root.review: VerticalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-xs;
            for line in InstallBridge.technical: Text {
                text: line;
                color: Theme.text-2;
                font-family: Theme.font-mono;
                font-size: Theme.size-label;
                wrap: word-wrap;
            }
        }

        if InstallBridge.report != "": Text {
            vertical-stretch: 0;
            text: InstallBridge.report;
            color: Theme.text-2;
            font-size: Theme.size-label;
            wrap: word-wrap;
        }

        // The buttons: they stay at the bottom of the card and keep their size.
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-m;
            alignment: start;

            if InstallBridge.has-primary: TwButton {
                text: InstallBridge.primary-text;
                primary: true;
                enabled: InstallBridge.primary-enabled;
                autofocus: InstallBridge.focus == InstallFocus.primary;
                focus-request: InstallBridge.focus-serial;
                clicked => {
                    InstallBridge.primary();
                }
            }

            if InstallBridge.has-secondary: TwButton {
                text: InstallBridge.secondary-text;
                autofocus: InstallBridge.focus == InstallFocus.secondary;
                focus-request: InstallBridge.focus-serial;
                clicked => {
                    InstallBridge.secondary();
                }
            }

            if root.review: Text {
                text: InstallBridge.hint;
                color: Theme.text-3;
                font-size: Theme.size-label;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        if root.review: HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-m;
            Text {
                horizontal-stretch: 1;
                text: InstallBridge.primary-note;
                color: Theme.text-2;
                font-size: Theme.size-label;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            TwButton {
                text: root.technical-open ? "Hide technical details" : "Technical details";
                clicked => {
                    InstallBridge.list-y = 0px;
                    root.technical-open = !root.technical-open;
                }
            }
        }
    }
}
