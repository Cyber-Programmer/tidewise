import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TwButton } from "../widgets/button.slint";
import { InstallBridge, InstallCardKind } from "bridge.slint";
import { InstallCard } from "install-card.slint";

// The install screen: breadcrumb, heading, the three steps, then one card. It replaces the Search screen while an
// install is open; Search keeps its results meanwhile (they live in Rust, not here). Escape = the secondary button.
//
// Layout rules (docs/design/tokens.md, "Layout rules"): the column stretches up to `Theme.content-max-width` and is
// centred beyond it; the card takes the spare height (lists share it, see install-card.slint); the screen scrolls
// only when even the smallest card does not fit.
export component InstallScreen inherits Rectangle {
    background: Theme.bg;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                InstallBridge.secondary();
                return accept;
            }
            return reject;
        }

        scroller := ScrollView {
            // As tall as the window, or as tall as the smallest page needs, whichever is more: the last resort.
            content-height: max(page.min-height, scroller.visible-height);

            page := VerticalLayout {
                padding-left: Theme.page-padding-x;
                padding-right: Theme.page-padding-x;
                padding-top: Theme.page-padding-y;
                padding-bottom: Theme.page-padding-y;

                HorizontalLayout {
                    alignment: center;

                    column := VerticalLayout {
                        max-width: Theme.content-max-width;
                        horizontal-stretch: 1;
                        spacing: Theme.section-gap;

                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.space-m;
                            VerticalLayout {
                                spacing: Theme.space-xs;
                                alignment: start;
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: Theme.space-xs;
                                    // "Search" leaves the install; the rest is only the name.
                                    TwButton {
                                        text: "Search";
                                        // A running install cannot be left.
                                        enabled: InstallBridge.kind != InstallCardKind.progress;
                                        clicked => {
                                            InstallBridge.cancel();
                                        }
                                    }

                                    Text {
                                        text: "› " + InstallBridge.crumb;
                                        color: Theme.text-3;
                                        font-size: Theme.size-body;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: InstallBridge.heading;
                                    color: Theme.text;
                                    font-size: Theme.size-page-title;
                                    font-weight: Theme.weight-semibold;
                                    accessible-role: text;
                                }
                            }

                            Rectangle { }

                            // The three steps, lined up with the card's right edge.
                            HorizontalLayout {
                                spacing: Theme.space-s;
                                alignment: end;
                                for name[index] in ["Choose", "Review", "Install"]: Rectangle {
                                    height: 28px;
                                    y: 8px;
                                    border-radius: 14px;
                                    background: index == InstallBridge.current-pill ? Theme.nav-active : transparent;
                                    accessible-role: text;
                                    accessible-label: (index + 1) + " " + name + (index == InstallBridge.current-pill ? ", current step" : "");
                                    HorizontalLayout {
                                        padding-left: Theme.space-m;
                                        padding-right: Theme.space-m;
                                        spacing: Theme.space-xs;
                                        Text {
                                            text: index + 1;
                                            color: index == InstallBridge.current-pill ? Theme.text : Theme.text-3;
                                            font-family: Theme.font-mono;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: name;
                                            color: index == InstallBridge.current-pill ? Theme.text : Theme.text-3;
                                            font-size: Theme.size-label;
                                            font-weight: index == InstallBridge.current-pill ? Theme.weight-semibold : Theme.weight-regular;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        InstallCard {
                            vertical-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
