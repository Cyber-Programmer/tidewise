// The only place Rust and the install screens meet. Rust fills the `in` properties (all decided and worded in
// crates/app/src/install_view.rs); the screen only lays them out and reports clicks and keys back.
import { ChoiceOption } from "../widgets/choice-list.slint";

// Which card fills the screen.
export enum InstallCardKind {
    closed,
    working,
    stale,
    provider,
    members,
    choice,
    differs,
    alert,
    review,
    progress,
    done,
}

// Where one stage of an install stands.
export enum InstallStageState {
    done,
    now,
    later,
}

export struct InstallStageData {
    label: string,
    state: InstallStageState,
}

// Which element takes the keyboard focus when a card appears.
export enum InstallFocus {
    list,
    primary,
    secondary,
}

// A key that scrolls the review list.
export enum ReviewKey {
    up,
    down,
    page-up,
    page-down,
    home,
    end,
}

// One of the review's three figures. `words`: `number` is a sentence.
export struct TileData {
    label: string,
    number: string,
    unit: string,
    words: bool,
}

// One package of the review list.
export struct ReviewRowData {
    name: string,
    version: string,
    why: string,
    size: string,
    bold: bool,
}

export struct InstalledRowData {
    name: string,
    version: string,
}

export global InstallBridge {
    in property <bool> open;
    in property <string> heading;
    // What follows "Search ›" in the breadcrumb.
    in property <string> crumb;
    // Which of Choose / Review / Install is current.
    in property <int> current-pill;
    in property <InstallCardKind> kind;
    in property <string> step-text;
    // One per question: 0 answered, 1 shown, 2 to come.
    in property <[int]> dots;
    // The title in three pieces; the middle one is monospaced.
    in property <string> title-before;
    in property <string> title-mono;
    in property <string> title-after;
    in property <string> body;
    in property <string> group-label;
    in property <[ChoiceOption]> options;
    // Position of the checked option of a radio list, or -1.
    in property <int> selected-index;
    in property <string> selection-text;
    in property <bool> show-select-buttons;
    in property <string> installed-heading;
    in property <[InstalledRowData]> installed-rows;
    in property <[string]> code-lines;
    in property <bool> has-primary;
    in property <string> primary-text;
    in property <bool> primary-enabled;
    in property <bool> has-secondary;
    in property <string> secondary-text;
    in property <string> unchanged;
    in property <string> slow-note;
    in property <string> hint;
    // Said when the updates check could only use older package lists.
    in property <string> lists-note;
    in property <string> report;
    in property <[string]> technical;
    in property <[TileData]> tiles;
    in property <[ReviewRowData]> review-rows;
    // The progress card: its stages, how far (0 to 100), and the same as words ("" before the helper says anything).
    in property <[InstallStageData]> stages;
    in property <int> percent;
    in property <string> percent-text;
    // The done card warns instead of confirming.
    in property <bool> attention;
    // Under the buttons: why the primary one is off.
    in property <string> primary-note;
    // Where the list in the card is scrolled to (content-y) and how much of it shows. Rust keeps the focused or
    // chosen row in view with the package list's scrolling maths.
    in-out property <length> list-y;
    in-out property <length> list-visible-height;
    in property <InstallFocus> focus;
    in property <int> focus-serial;

    // A radio option was chosen, a checkbox flipped.
    callback choose(int);
    // The row that takes the keyboard focus when `focus-row-request` changes (Up and Down between checkbox rows).
    in property <int> focus-row: -1;
    in property <int> focus-row-request;
    // A checkbox row got the keyboard focus.
    callback row-focused(int);
    // Up (-1) or Down (+1) on a checkbox row.
    callback row-moved(int, int);
    // The visible part of the list changed size (first layout, window resized).
    callback list-resized();
    callback toggle(int);
    // A scrolling key on the review list, with the height of everything in it.
    callback review-key(ReviewKey, length);
    callback select-all();
    callback select-none();
    // The main button of the card, whatever it is for (next, continue, install instead, try again).
    callback primary();
    // Cancel or Back (also Escape).
    callback secondary();
    // The "Search" part of the breadcrumb: leave the install.
    callback cancel();
    // Fired on the UI thread when the worker thread has put its answer in its mailbox.
    callback resolve-done();
    // The same for the helper job: an event or its end is waiting.
    callback job-event();
}
