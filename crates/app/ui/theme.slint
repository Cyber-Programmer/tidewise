// Every colour, size and font of docs/design/tokens.md. Nothing else may be used in the UI.
// `dark` picks the column. `mode` comes from the user's settings: 0 follow the desktop's light or
// dark mode (Slint's own colour-scheme report, unknown counts as dark), 1 dark (the default here, so
// screenshots stay the same), 2 light.
import { Palette } from "std-widgets.slint";
import "../../../assets/fonts/Geist-Regular.ttf";
import "../../../assets/fonts/Geist-Medium.ttf";
import "../../../assets/fonts/Geist-SemiBold.ttf";
import "../../../assets/fonts/Geist-Bold.ttf";
import "../../../assets/fonts/GeistMono-Regular.ttf";
import "../../../assets/fonts/GeistMono-Medium.ttf";

export global Theme {
    in property <int> mode: 1;
    out property <bool> dark: root.mode == 1 || (root.mode == 0 && Palette.color-scheme != ColorScheme.light);

    // Surfaces and text
    out property <color> bg: dark ? #0D0F13 : #F5F6F8;
    out property <color> sidebar: dark ? #111419 : #ECEEF2;
    out property <color> surface: dark ? #161A21 : #FFFFFF;
    out property <color> surface-sunk: dark ? #12161C : #F0F2F5;
    out property <color> border: dark ? #232933 : #E1E4EA;
    out property <color> text: dark ? #ECEEF2 : #14171C;
    out property <color> text-2: dark ? #A9B0BC : #4A5260;
    out property <color> text-3: dark ? #808897 : #5F6775;

    // Accent
    out property <color> accent: dark ? #5DDCB0 : #12B886;
    out property <color> on-accent: #052B1F;
    out property <color> accent-text: dark ? #5DDCB0 : #0B7A5A;
    out property <color> accent-tint: dark ? #173A2F : #DDF5EC;

    // Warning and danger
    out property <color> warn: dark ? #F2B84B : #9A6700;
    out property <color> warn-tint: dark ? #3A2E14 : #FFF3D6;
    // Small text on warn-tint: amber on its own tint is only 4.41:1 in the light theme, so the light
    // theme uses text-2 (#4A5260, an existing token). Dark is the same amber as `warn`.
    out property <color> warn-chip-text: dark ? #F2B84B : #4A5260;
    out property <color> danger: dark ? #FF8A80 : #C73A2E;
    out property <color> on-danger: dark ? #3A0B07 : #FFFFFF;
    // tokens.md has no light danger tint yet; the dark one is reused until it does.
    out property <color> danger-tint: dark ? #3A1714 : #E1E4EA;

    // Data colours
    out property <color> data-cpu: dark ? #7AA7FF : #2F5FD0;
    out property <color> data-memory: dark ? #F2B84B : #9A6700;
    out property <color> data-disk: dark ? #C3A2FF : #7048C8;
    out property <color> data-network: dark ? #5DDCB0 : #0B7A5A;

    // Source chips (text on background); tokens.md gives dark values only
    out property <color> chip-system: dark ? #7AA7FF : #2F5FD0;
    out property <color> chip-system-bg: dark ? #1B2A45 : #E1E4EA;
    out property <color> chip-flatpak: dark ? #C3A2FF : #7048C8;
    out property <color> chip-flatpak-bg: dark ? #2C2342 : #E1E4EA;
    out property <color> chip-appimage: dark ? #F2B84B : #9A6700;
    out property <color> chip-appimage-bg: dark ? #3A2E14 : #FFF3D6;
    out property <color> chip-snap: dark ? #C9CED6 : #4A5260;
    out property <color> chip-snap-bg: dark ? #2A303B : #E1E4EA;

    // Extra shades: the first nine are listed in tokens.md under "Extra shades used by the
    // artboards" and use its names; the rest are not listed there yet (see docs/questions.md, M1-T3).
    out property <color> nav-text: dark ? #B4BAC5 : #4A5260;
    out property <color> nav-active-bg: dark ? #1E232C : #FFFFFF;
    out property <color> nav-active-text: dark ? #F2F4F7 : #14171C;
    out property <color> tab-selected-bg: dark ? #1C222B : #E1E4EA;
    out property <color> sidebar-border: dark ? #1F242D : #E1E4EA;
    out property <color> text-soft: dark ? #C9CED6 : #4A5260;
    out property <color> border-subtle: dark ? #222832 : #E1E4EA;
    out property <color> row-divider: dark ? #1E232B : #E1E4EA;
    out property <color> control-border: dark ? #2A303B : #E1E4EA;
    out property <color> control-bg: dark ? #1A1F27 : #FFFFFF;
    out property <color> row-selected: dark ? #1C2A26 : #DDF5EC;
    out property <color> panel-bg: dark ? #1A2028 : #FFFFFF;
    out property <color> panel-border: dark ? #2A313C : #E1E4EA;
    out property <color> search-border: dark ? #252B35 : #E1E4EA;
    out property <color> segment-on: dark ? #262D38 : #FFFFFF;
    out property <color> mono-dim: dark ? #B9C0CB : #4A5260;
    out property <color> badge-bg: dark ? #232933 : #E1E4EA;

    // Shades of the Storage artboard that tokens.md does not list (docs/questions.md, R4-T3).
    out property <color> drive-track: dark ? #0F1217 : #F0F2F5;
    out property <color> warn-note: dark ? #E6CF9E : #9A6700;
    out property <color> warn-banner-bg: dark ? #1E1A10 : #FFF3D6;
    out property <color> warn-button-bg: dark ? #2A2312 : #FFF3D6;
    out property <color> warn-button-border: dark ? #4A3B1A : #9A6700;
    out property <color> warn-button-text: dark ? #F5D898 : #9A6700;

    // Shades of the Cleaner and Clean flow artboards that tokens.md does not list (docs/questions.md, R6-Q06).
    out property <color> note-card-bg: dark ? #13221D : #DDF5EC;
    out property <color> note-card-border: dark ? #1F3A31 : #12B886;
    out property <color> note-card-title: dark ? #8BEACB : #0B7A5A;
    out property <color> note-card-text: dark ? #B9D9CC : #4A5260;
    out property <color> scrim: #06070A99;
    out property <color> dialog-border: dark ? #2E3541 : #E1E4EA;

    // Toast (artboard F)
    out property <color> toast-bg: dark ? #1E2A27 : #DDF5EC;
    out property <color> toast-border: dark ? #3E7D69 : #12B886;

    // Folder-map block colours by number: background, and the colour of the small note on it.
    public pure function tile-bg(i: int) -> color {
        i == 0 ? #2E2547 : (i == 1 ? #3A2E14 : (i == 2 ? #1B2A45 : (i == 3 ? #173A2F : (i == 4 ? #262B34 : #23303F))))
    }
    public pure function tile-note(i: int) -> color {
        i == 0 ? #C9BCEB : (i == 1 ? #E6CF9E : text-2)
    }
    // Drive-bar segment colours by number.
    public pure function seg-color(i: int) -> color {
        i == 0 ? #C3A2FF : (i == 1 ? #7AA7FF : (i == 2 ? #4D72B8 : (i == 3 ? #8E6FD6 : (i == 4 ? #5DDCB0 : #5A6272))))
    }

    // Data colour by number: 0 processor, 1 memory, 2 disk, 3 network, 4 muted text.
    public pure function hue(i: int) -> color {
        i == 0 ? data-cpu : (i == 1 ? data-memory : (i == 2 ? data-disk : (i == 3 ? data-network : text-2)))
    }

    // Fonts. Geist for text, Geist Mono for every number, path and command.
    out property <string> sans: "Geist";
    out property <string> mono: "Geist Mono";

    // Type sizes
    out property <length> size-display: 34px;
    out property <length> size-h1: 26px;
    out property <length> size-h2: 22px;
    out property <length> size-row-title: 15px;
    out property <length> size-body: 14px;
    out property <length> size-small: 13px;
    out property <length> size-caption: 12px;

    // Radius
    out property <length> radius-chip: 6px;
    out property <length> radius-button: 10px;
    out property <length> radius-row: 14px;
    out property <length> radius-card: 16px;
    out property <length> radius-hero: 18px;
    out property <length> radius-dialog: 20px;
    out property <length> radius-pill: 99px;

    // Sizes
    out property <length> sidebar-width: 220px;
    out property <length> content-max-width: 1120px;
}
