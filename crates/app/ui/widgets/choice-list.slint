import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// One option of a radio list or a checkbox list. Rust fills it from `InstallView` (crates/app/src/install_view.rs).
export struct ChoiceOption {
    label: string,
    // A version, small and monospaced beside the label.
    meta: string,
    detail: string,
    // "pacman's default", or empty.
    tag: string,
    checked: bool,
}

component RadioRow inherits Rectangle {
    in property <ChoiceOption> option;
    callback pressed();

    height: Theme.choice-radio-row;
    background: root.option.checked ? Theme.surface-2 : Theme.surface;

    // The group (one Tab stop) is what has the focus; the rows are read as radio buttons inside it.
    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked: root.option.checked;
    accessible-label: root.option.detail == "" ? root.option.label : root.option.label + ". " + root.option.detail;
    accessible-action-default => {
        root.pressed();
    }

    TouchArea {
        clicked => {
            root.pressed();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-l;
        padding-right: Theme.space-l;
        padding-top: Theme.space-s;
        padding-bottom: Theme.space-s;
        spacing: Theme.space-l;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 2px;
                border-color: root.option.checked ? Theme.accent : Theme.switch-off;
                background: Theme.surface;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    visible: root.option.checked;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-m;
                Text {
                    text: root.option.label;
                    color: Theme.text;
                    font-size: Theme.size-row-title;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }

                Text {
                    text: root.option.meta;
                    color: Theme.text-3;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-label;
                    vertical-alignment: center;
                }

                if root.option.tag != "": Rectangle {
                    background: Theme.tide-fill;
                    border-radius: Theme.radius-chip;
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        padding-left: Theme.space-s;
                        padding-right: Theme.space-s;
                        padding-top: 1px;
                        padding-bottom: 1px;
                        Text {
                            text: root.option.tag;
                            color: Theme.accent-hover;
                            font-size: 12px;
                            font-weight: Theme.weight-semibold;
                        }
                    }
                }
            }

            if root.option.detail != "": Text {
                text: root.option.detail;
                color: Theme.text-3;
                font-size: Theme.size-label;
                overflow: elide;
            }
        }
    }
}

// A radio group: ONE Tab stop. Up/Down (and Home/End) move the choice, like native radio buttons; a click chooses.
// Rust owns the choice: this only reports `chosen(index)`.
export component RadioList inherits Rectangle {
    in property <[ChoiceOption]> options;
    // Position of the checked option, or -1.
    in property <int> selected: -1;
    // What a screen reader says for the group, e.g. "Question 2 of 3. Pick a package for java-runtime".
    in property <string> label;
    // Takes the focus when it appears and whenever `focus-request` changes (a new question replaced the old one).
    in property <bool> autofocus: true;
    in property <int> focus-request: 0;
    // Where the list is scrolled to (Slint's content-y: 0 at the top, negative when scrolled down), and how much
    // of it shows. Rust reads both to keep the chosen row in view. The parent sets `height`; a long list scrolls.
    in-out property <length> scroll-y;
    in-out property <length> visible-height;
    callback chosen(int);
    // The visible part of the list changed size (first layout, window resized).
    callback resized();

    background: Theme.surface;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    init => {
        if (root.autofocus) {
            focus.focus();
        }
    }
    changed focus-request => {
        if (root.autofocus) {
            focus.focus();
        }
    }

    focus := FocusScope {
        accessible-role: groupbox;
        accessible-label: root.label;
        accessible-value: root.selected >= 0 ? root.options[root.selected].label : "";
        key-pressed(event) => {
            if (event.text == Key.UpArrow && root.selected > 0) {
                root.chosen(root.selected - 1);
            } else if (event.text == Key.DownArrow && root.selected < root.options.length - 1) {
                root.chosen(root.selected + 1);
            } else if (event.text == Key.Home && root.options.length > 0) {
                root.chosen(0);
            } else if (event.text == Key.End && root.options.length > 0) {
                root.chosen(root.options.length - 1);
            } else if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Home || event.text == Key.End) {
                // At the first or last option: the key is used up, not passed on.
            } else {
                return reject;
            }
            return accept;
        }
    }

    ScrollView {
        content-y <=> root.scroll-y;
        changed visible-height => {
            root.visible-height = self.visible-height;
            root.resized();
        }

        VerticalLayout {
            for option[index] in root.options: VerticalLayout {
                if index > 0: Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                RadioRow {
                    option: option;
                    pressed => {
                        focus.focus();
                        root.chosen(index);
                    }
                }
            }
        }
    }

    // Focus ring, drawn over the list.
    Rectangle {
        border-radius: Theme.radius-control;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.accent;
    }
}

// One checkbox row: its own Tab stop; Space, Enter or a click flips it.
export component CheckRow inherits Rectangle {
    in property <ChoiceOption> option;
    in property <bool> autofocus: false;
    in property <int> focus-request: 0;
    callback toggled();
    // The row got the keyboard focus (Tab or a click): the list around it scrolls to show it.
    callback focused();
    // Up (-1) or Down (+1) was pressed on the row: Rust says which row is next (`focus-row`).
    callback moved(int);
    in property <int> row-index;
    in property <int> focus-row: -1;
    in property <int> focus-row-request: 0;
    changed focus-row-request => {
        if (root.focus-row == root.row-index) {
            focus.focus();
        }
    }

    height: Theme.choice-check-row;
    background: Theme.surface;

    property <bool> has-focus: focus.has-focus;
    changed has-focus => {
        if (root.has-focus) {
            root.focused();
        }
    }

    init => {
        if (root.autofocus) {
            focus.focus();
        }
    }
    changed focus-request => {
        if (root.autofocus) {
            focus.focus();
        }
    }

    focus := FocusScope {
        accessible-role: checkbox;
        accessible-checkable: true;
        accessible-checked: root.option.checked;
        accessible-label: root.option.meta == "" ? root.option.label : root.option.label + " " + root.option.meta;
        accessible-action-default => {
            root.toggled();
        }
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggled();
                return accept;
            } else if (event.text == Key.UpArrow) {
                root.moved(-1);
                return accept;
            } else if (event.text == Key.DownArrow) {
                root.moved(1);
                return accept;
            }
            return reject;
        }
    }

    TouchArea {
        clicked => {
            focus.focus();
            root.toggled();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-l;
        padding-right: Theme.space-l;
        spacing: Theme.space-m;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 4px;
                border-width: 2px;
                border-color: root.option.checked ? Theme.accent : Theme.switch-off;
                background: root.option.checked ? Theme.accent : Theme.surface;
                Path {
                    width: 12px;
                    height: 12px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M5 12l5 5 9-10";
                    stroke: Theme.on-accent;
                    stroke-width: 2px;
                    visible: root.option.checked;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.option.label;
                color: Theme.text;
                font-family: Theme.font-mono;
                font-size: Theme.size-label;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.option.meta;
                color: Theme.text-3;
                font-family: Theme.font-mono;
                font-size: 12px;
            }
        }
    }

    Rectangle {
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.accent;
    }
}
