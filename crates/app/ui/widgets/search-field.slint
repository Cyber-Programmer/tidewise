import { Theme } from "../theme.slint";

// A one-line search box with a placeholder and a clear button (shown only when there is text).
export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    // Optional SVG path data (24 x 24 grid) for a small icon before the text.
    in property <string> icon;
    // Fired for every change the user makes, including pressing the clear button.
    callback edited(string);

    min-height: Theme.min-target;
    border-radius: Theme.radius-control;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.control-border;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: Theme.space-m;
        spacing: Theme.space-s;

        if root.icon != "": VerticalLayout {
            alignment: center;
            Path {
                width: 17px;
                height: 17px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                stroke: Theme.text-3;
                stroke-width: 1.9px;
                stroke-line-cap: round;
            }
        }

        Rectangle {
            input := TextInput {
                text <=> root.text;
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                color: Theme.text;
                font-size: Theme.size-body;
                single-line: true;
                accessible-label: root.placeholder;
                edited => {
                    root.edited(self.text);
                }
            }

            if root.text == "": Text {
                text: root.placeholder;
                color: Theme.text-3;
                font-size: Theme.size-body;
                x: 0px;
                y: (parent.height - self.height) / 2;
            }
        }

        // The clear button: a 44x44 click target (transparent) around a small 28x28 square,
        // so the square sits inside the field with space around it, away from the border.
        if root.text != "": Rectangle {
            width: Theme.min-target;

            accessible-role: button;
            accessible-label: "Clear search";
            accessible-action-default => {
                root.text = "";
                root.edited("");
            }

            clear-focus := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == " ") {
                        root.text = "";
                        root.edited("");
                        return accept;
                    }
                    return reject;
                }
            }

            clear-touch := TouchArea {
                clicked => {
                    root.text = "";
                    root.edited("");
                    input.focus();
                }
            }

            Rectangle {
                width: Theme.size-icon-button;
                height: Theme.size-icon-button;
                border-radius: Theme.radius-chip;
                background: clear-touch.pressed ? Theme.chip : (clear-touch.has-hover ? Theme.surface-2 : transparent);
                border-width: clear-focus.has-focus ? 2px : 0px;
                border-color: Theme.accent;

                Text {
                    text: "×";
                    color: Theme.text-2;
                    font-size: Theme.size-dialog-title;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
