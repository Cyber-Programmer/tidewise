import { Theme } from "../theme.slint";

// A real button: Tab reaches it, Enter or Space presses it, a ring shows the focus.
// `primary` = teal (a reversible action); otherwise a neutral outlined button.
// Off (`enabled: false`): grey, ignores clicks and keys, still reachable with Tab so a screen reader can say
// it is unavailable.
export component TwButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    // Takes the keyboard focus when it appears and whenever `focus-request` changes (a new card replaced the old one).
    in property <bool> autofocus: false;
    in property <int> focus-request: 0;
    callback clicked();

    min-height: Theme.min-target;
    // Never narrower than its own text plus its padding, so a tight row cannot squeeze the words out of the border.
    min-width: max(Theme.min-target, label.preferred-width + 2 * Theme.space-l);
    horizontal-stretch: 0;
    border-radius: Theme.radius-control;
    border-width: 1px;
    background: !root.enabled
        ? Theme.control-border
        : root.primary
            ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
            : (touch.has-hover ? Theme.surface-2 : Theme.surface);
    border-color: root.primary && root.enabled ? self.background : Theme.control-border;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    init => {
        if (root.autofocus) {
            focus.focus();
        }
    }
    changed focus-request => {
        if (root.autofocus) {
            focus.focus();
        }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == " ")) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-l;
        padding-right: Theme.space-l;
        alignment: center;
        label := Text {
            text: root.text;
            color: !root.enabled ? Theme.text-2 : root.primary ? Theme.on-accent : Theme.text;
            font-size: Theme.size-body;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }

    // Focus ring, drawn over the button.
    Rectangle {
        border-radius: Theme.radius-control;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: root.primary && root.enabled ? Theme.text : Theme.accent;
    }
}
