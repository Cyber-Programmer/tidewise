// The window: sidebar plus the page picked by `Shell.page`.
import { Theme } from "theme.slint";
import { Shell, Sidebar } from "components.slint";
import { PerformanceScreen, PerfState } from "performance.slint";

export { Shell, PerfState }

component ComingLater inherits Rectangle {
    background: Theme.bg;
    Text {
        text: "Coming in a later version";
        color: Theme.text-2;
        font-size: Theme.size-body;
    }
}

export component MainWindow inherits Window {
    title: "Tidewise";
    min-width: 900px;
    min-height: 600px;
    preferred-width: 1360px;
    preferred-height: 960px;
    background: Theme.bg;
    default-font-family: Theme.sans;
    default-font-size: Theme.size-body;

    HorizontalLayout {
        Sidebar { }
        if Shell.page == 4: PerformanceScreen { }
        if Shell.page != 4: ComingLater { }
    }
}
