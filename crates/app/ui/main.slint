import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TwButton, Segmented, SearchField, Chip, LetterTile, Logo } from "widgets/widgets.slint";
import "./fonts/IBMPlexSans-Regular.ttf";
import "./fonts/IBMPlexSans-Medium.ttf";
import "./fonts/IBMPlexSans-SemiBold.ttf";
import "./fonts/IBMPlexMono-Regular.ttf";

export component MainWindow inherits Window {
    in property <string> app-name;

    title: root.app-name;
    preferred-width: 480px;
    preferred-height: 320px;
    background: Theme.bg;
    default-font-family: Theme.font-sans;

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    Text {
        text: root.app-name;
        font-size: Theme.size-page-title;
        font-weight: Theme.weight-semibold;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
