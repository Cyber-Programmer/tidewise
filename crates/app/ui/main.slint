import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Sidebar } from "nav/sidebar.slint";
import { CloseBridge, CloseDialog } from "widgets/close-dialog.slint";
import { NavBridge, Screen } from "nav/bridge.slint";
import { SearchScreen } from "search/search-screen.slint";
import { AppsScreen } from "apps/apps-screen.slint";
import { InstallScreen } from "install/install-screen.slint";
import { UpdateScreen } from "update/update-screen.slint";
import { UpdateBridge, UpdateCardKind } from "update/bridge.slint";
import { InstallBridge, InstallCardKind, InstallFocus, InstallStageData, InstallStageState, InstalledRowData } from "install/bridge.slint";
import { ChoiceOption } from "widgets/choice-list.slint";
import { AppsBridge, BodyKind, DetailsData, ListKey, PackageRow } from "apps/bridge.slint";
import { ResultRow, SearchBodyKind, SearchBridge, SearchDetailsData, SearchDetailsKind } from "search/bridge.slint";

import "./fonts/IBMPlexSans-Regular.ttf";
import "./fonts/IBMPlexSans-Medium.ttf";
import "./fonts/IBMPlexSans-SemiBold.ttf";
import "./fonts/IBMPlexMono-Regular.ttf";

// Rust reaches these through the generated code, so they are re-exported here.
export { AppsBridge, BodyKind, ChoiceOption, CloseBridge, DetailsData, InstallBridge, InstallCardKind, InstallFocus, InstallStageData, InstallStageState, InstalledRowData, ListKey, NavBridge, PackageRow, ResultRow, Screen, SearchBodyKind, SearchBridge, SearchDetailsData, SearchDetailsKind, Theme, UpdateBridge, UpdateCardKind }

export component MainWindow inherits Window {
    in property <string> app-name;

    title: root.app-name;
    preferred-width: 1200px;
    preferred-height: 800px;
    // Narrower than this the list, details and header would start to overlap.
    min-width: 1100px;
    min-height: 640px;
    background: Theme.bg;
    default-font-family: Theme.font-sans;

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    HorizontalLayout {
        // Hidden while the close dialog is up, so that Tab cannot reach it.
        visible: !CloseBridge.open;
        Sidebar { }

        if NavBridge.current == Screen.apps: AppsScreen {
            horizontal-stretch: 1;
        }

        // An open install replaces the Search screen; Search's state lives in Rust, so it comes back as it was.
        if NavBridge.current == Screen.search && !InstallBridge.open: SearchScreen {
            horizontal-stretch: 1;
        }

        if NavBridge.current == Screen.search && InstallBridge.open: InstallScreen {
            horizontal-stretch: 1;
        }

        // The update screen's state lives in Rust: leaving it and coming back shows the same card.
        if NavBridge.current == Screen.updates: UpdateScreen {
            horizontal-stretch: 1;
        }
    }

    if CloseBridge.open: CloseDialog {
        width: root.width;
        height: root.height;
    }
}
