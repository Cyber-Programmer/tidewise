import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Sidebar } from "nav/sidebar.slint";
import { AppsScreen } from "apps/apps-screen.slint";
import { AppsBridge, BodyKind, DetailsData, ListKey, PackageRow } from "apps/bridge.slint";

import "./fonts/IBMPlexSans-Regular.ttf";
import "./fonts/IBMPlexSans-Medium.ttf";
import "./fonts/IBMPlexSans-SemiBold.ttf";
import "./fonts/IBMPlexMono-Regular.ttf";

// Rust reaches these through the generated code, so they are re-exported here.
export { AppsBridge, BodyKind, DetailsData, ListKey, PackageRow, Theme }

export component MainWindow inherits Window {
    in property <string> app-name;

    title: root.app-name;
    preferred-width: 1200px;
    preferred-height: 800px;
    // Narrower than this the list, details and header would start to overlap.
    min-width: 1100px;
    min-height: 640px;
    background: Theme.bg;
    default-font-family: Theme.font-sans;

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    HorizontalLayout {
        Sidebar { }

        AppsScreen {
            horizontal-stretch: 1;
        }
    }
}
