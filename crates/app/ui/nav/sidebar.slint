import { Theme } from "../theme.slint";
import { Logo } from "../widgets/logo.slint";
import { NavBridge, Screen } from "bridge.slint";
import { NavItem } from "nav-item.slint";

// Only items that work today: Apps and Search. More arrive with their screens.
export component Sidebar inherits Rectangle {
    width: 220px;
    background: Theme.bg;

    // Hairline on the right edge.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.rule;
    }

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-xl;

        HorizontalLayout {
            spacing: Theme.space-s;
            padding-left: Theme.space-s;
            Logo { }

            Text {
                text: "Tidewise";
                color: Theme.text;
                font-size: Theme.size-row-title;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 2px;
            NavItem {
                label: "Apps";
                icon: "M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z";
                current: NavBridge.current == Screen.apps;
                clicked => {
                    NavBridge.current = Screen.apps;
                }
            }

            NavItem {
                label: "Search";
                icon: "M10.5 4a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13M15.5 15.5L20 20";
                current: NavBridge.current == Screen.search;
                clicked => {
                    NavBridge.current = Screen.search;
                }
            }
        }

        Rectangle { }

        Text {
            text: "Arch Linux";
            color: Theme.text-3;
            font-size: Theme.size-label;
            horizontal-alignment: left;
        }
    }
}
