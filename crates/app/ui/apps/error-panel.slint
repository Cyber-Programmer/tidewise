import { Theme } from "../theme.slint";
import { TwButton } from "../widgets/button.slint";

// Shown instead of the list when pacman fails. Amber (a warning), never red: nothing was changed.
export component ErrorPanel inherits Rectangle {
    background: Theme.warning-bg;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.warning;

    // Words come from the screen that uses the panel (each screen has its own bridge).
    in property <string> title;
    in property <string> body;
    in property <string> unchanged;
    in property <string> technical;
    in property <string> report;
    callback try-again();

    // View state only: is the "Technical details" part open?
    property <bool> technical-open: false;

    VerticalLayout {
        padding: Theme.space-xl;
        spacing: Theme.space-m;
        alignment: start;

        Text {
            text: root.title;
            color: Theme.warning;
            font-size: Theme.size-dialog-title;
            font-weight: Theme.weight-semibold;
            wrap: word-wrap;
        }

        Text {
            text: root.body;
            color: Theme.text;
            font-size: Theme.size-body;
            wrap: word-wrap;
        }

        Text {
            text: root.unchanged;
            color: Theme.text;
            font-size: Theme.size-body;
            font-weight: Theme.weight-medium;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.space-s;
            TwButton {
                text: "Try again";
                primary: true;
                clicked => {
                    root.try-again();
                }
            }

            TwButton {
                text: root.technical-open ? "Hide technical details" : "Technical details";
                clicked => {
                    root.technical-open = !root.technical-open;
                }
            }

            Rectangle { }
        }

        if root.technical-open: Text {
            text: root.technical;
            color: Theme.text-2;
            font-family: Theme.font-mono;
            font-size: Theme.size-label;
            wrap: word-wrap;
        }

        Text {
            text: root.report;
            color: Theme.text-2;
            font-size: Theme.size-label;
            wrap: word-wrap;
        }
    }
}
