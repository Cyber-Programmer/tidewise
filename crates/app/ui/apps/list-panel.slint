import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TwButton } from "../widgets/button.slint";
import { AppsBridge, BodyKind, ListKey } from "bridge.slint";
import { PackageRowItem } from "package-row.slint";
import { SkeletonRow } from "skeleton-row.slint";

// The white panel with the list. Shows skeleton rows, the rows, or an empty-state message.
export component ListPanel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    min-width: 420px;

    VerticalLayout {
        if AppsBridge.body == BodyKind.loading: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            accessible-role: groupbox;
            accessible-label: "Loading the list of installed packages";
            for i in 8: SkeletonRow { }
        }

        // The list is ONE Tab stop (listbox pattern): Tab enters it, the next Tab leaves it.
        // Up/Down/Home/End/Page Up/Page Down move the selection; Rust keeps the row in view.
        if AppsBridge.body == BodyKind.list: Rectangle {
            vertical-stretch: 1;

            list-focus := FocusScope {
                width: parent.width;
                height: parent.height;
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        AppsBridge.list-key(ListKey.up);
                    } else if (event.text == Key.DownArrow) {
                        AppsBridge.list-key(ListKey.down);
                    } else if (event.text == Key.Home) {
                        AppsBridge.list-key(ListKey.home);
                    } else if (event.text == Key.End) {
                        AppsBridge.list-key(ListKey.end);
                    } else if (event.text == Key.PageUp) {
                        AppsBridge.list-key(ListKey.page-up);
                    } else if (event.text == Key.PageDown) {
                        AppsBridge.list-key(ListKey.page-down);
                    } else {
                        return reject;
                    }
                    return accept;
                }
            }

            ListView {
                width: parent.width;
                height: parent.height;
                content-y <=> AppsBridge.list-content-y;
                changed visible-height => {
                    AppsBridge.list-visible-height = self.visible-height;
                    AppsBridge.list-resized();
                }

                for item[index] in AppsBridge.rows: PackageRowItem {
                    package: item;
                    index: index;
                    list-focused: list-focus.has-focus;
                    chosen => {
                        AppsBridge.row-chosen(item.name);
                        list-focus.focus();
                    }
                }
            }
        }

        if AppsBridge.body == BodyKind.empty: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: Theme.space-xl;
            spacing: Theme.space-s;

            Text {
                text: AppsBridge.empty-title;
                color: Theme.text;
                font-size: Theme.size-row-title;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if AppsBridge.empty-body != "": Text {
                text: AppsBridge.empty-body;
                color: Theme.text-2;
                font-size: Theme.size-body;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if AppsBridge.empty-button != "": HorizontalLayout {
                padding-top: Theme.space-m;
                alignment: center;
                TwButton {
                    text: AppsBridge.empty-button;
                    primary: true;
                    clicked => {
                        AppsBridge.empty-button-clicked();
                    }
                }
            }
        }

        if AppsBridge.footer != "": Rectangle {
            height: 40px;
            background: Theme.surface;
            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.rule;
            }

            Text {
                x: Theme.space-l;
                y: 0px;
                height: parent.height;
                text: AppsBridge.footer;
                color: Theme.text-3;
                font-family: Theme.font-mono;
                font-size: Theme.size-label;
                vertical-alignment: center;
            }
        }
    }
}
