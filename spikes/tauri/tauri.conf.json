{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidewise Spike",
  "version": "0.0.0",
  "identifier": "io.github.tidewise.spike",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tidewise spike (Tauri)",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
